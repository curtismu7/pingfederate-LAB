# Copy to .env (not committed). Only needed for LIVE mode over https (docker-compose.live.yml); mock mode needs no .env.
# Add the live file to every compose command: COMPOSE_FILE=docker-compose.yml:docker-compose.live.yml
# The host name in your PingFederate issuer, when it points at 127.0.0.1 on this Mac.
PF_HOSTNAME=pf.example
# The root certificate that signed your PingFederate's TLS certificate (for example a local mkcert root).
PFLAB_CA_FILE=/path/to/rootCA.pem
# Other names the lab answers to (comma separated), such as a local domain that points at 127.0.0.1.
LAB_ALLOWED_HOSTS=lab.local.example
# The certificate and key the lab serves https with; it must cover 127.0.0.1, localhost and LAB_ALLOWED_HOSTS.
PFLAB_TLS_CERT_FILE=/path/to/cert.pem
PFLAB_TLS_KEY_FILE=/path/to/key.pem
